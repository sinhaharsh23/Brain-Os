BRAINOS_HOST=127.0.0.1
BRAINOS_PORT=8765
BRAINOS_DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
BRAINOS_MAX_NEW_TOKENS_DEFAULT=800
BRAINOS_MAX_PROMPT_TOKENS=1024
BRAINOS_DEVICE=auto
BRAINOS_DTYPE=auto
BRAINOS_CAPTURE_INTERVAL_MS=500
BRAINOS_CAPTURE_LIMIT_TOKENS=256
BRAINOS_CAPTURE_LEVEL=summary
BRAINOS_ATTENTION_CAPTURE=true
BRAINOS_REPLAY_DIR=./replay_sessions
# Replay retention: the first exceeded limit wins.
BRAINOS_ENABLE_FULL_TENSOR_CACHE=false
BRAINOS_MAX_REPLAY_SESSIONS=10
BRAINOS_MAX_REPLAY_DISK_GB=1
BRAINOS_REPLAY_CAPTURE_STEPS=16
BRAINOS_REPLAY_MLP_CAPTURE_STEPS=4
BRAINOS_REPLAY_LOGIT_TOP_K=50
BRAINOS_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:5173
BRAINOS_MAX_PROMPT_CHARS=12000
BRAINOS_MAX_NEW_TOKENS_LIMIT=800
# Optional local deployment protection. Leave empty for localhost-only development.
# BRAINOS_AUTH_TOKEN=
# Set to multi_user to enable SQL-backed registration/login and owned resources.
# BRAINOS_AUTH_MODE=local
# BRAINOS_DATABASE_URL=sqlite:///./backend/brainos.db
# Alembic migrations run idempotently at startup by default. Set false when
# migrations are applied explicitly by the deployment process.
# BRAINOS_DATABASE_AUTO_MIGRATE=true
# BRAINOS_SCHEDULER_MAX_QUEUE_SIZE=4
# BRAINOS_SCHEDULER_MAX_ACTIVE=1
# BRAINOS_SCHEDULER_RUN_TIMEOUT_S=180
# VITE_BRAINOS_TOKEN=
# VITE_BRAINOS_WS_URL=
# HF_HOME=./models/hf
# Local model resolution is offline-first. Set LOCAL_MODEL_ALLOW_DOWNLOAD=true
# explicitly if startup is allowed to download a missing checkpoint.
LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# LOCAL_MODEL_PATH=./models/Qwen2.5-0.5B-Instruct
LOCAL_MODEL_OFFLINE=true
LOCAL_MODEL_ALLOW_DOWNLOAD=false
# Optional server-side external observation credentials. Never expose these to the frontend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Local Ollama endpoint and comma-separated installed model names.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELS=llama3.2
